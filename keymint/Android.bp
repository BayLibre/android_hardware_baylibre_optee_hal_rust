package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "android.hardware.security.keymint-service.optee.rust",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["src/keymint_hal_main.rs"],
    rustlibs: [
        "libandroid_logger",
        "libbinder_rs",
        "libclap",
        "libkmr_hal_v4",
        "libkmr_wire",
        "liblog_rust",
        "libtrusty-rs",
    ],
    prefer_rlib: true,
    init_rc: ["android.hardware.security.keymint-service.optee.rust.rc"],
    vintf_fragments: ["android.hardware.security.keymint-service.optee.rust.xml"],
    required: ["android.hardware.hardware_keystore_V4.xml"],
}
