package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Provisions the attestation IDs in the KeyMint TA, once per device.
rust_binary {
    name: "keymint-optee-provision-ids",
    vendor: true,
    srcs: ["src/main.rs"],
    rustlibs: [
        "libclap",
        "libkmr_wire",
        "librustutils",
        "libtee_optee_bindings",
        "libtee_optee_channel",
    ],
    shared_libs: ["libteec"],
    prefer_rlib: true,
}
